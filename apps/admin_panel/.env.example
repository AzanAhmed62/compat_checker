# Use the local Supabase stack output (`supabase start`), never a service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Required before publishing /privacy. These values are public.
# VITE_DATA_CONTROLLER=Example Repair Lab Ltd.
# VITE_SUPPORT_EMAIL=privacy@example.com
VITE_DATA_CONTROLLER=
VITE_SUPPORT_EMAIL=
