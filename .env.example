# Local development values only. Never commit real secrets.
# Prefer `supabase start` output for the local stack.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-side Edge Function secrets. These must never be exposed to clients.
# Comma-separated exact browser origins. Wildcards are ignored; the code falls
# back to local-only origins when this is unset.
ADMIN_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PURGE_CRON_SECRET=replace-with-a-high-entropy-random-value
