# SUPABASE_URL: The HTTPS URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
# In AI Studio, configure this in the Secrets panel.
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: The public anonymous API key for client-side requests.
# NEVER put service_role secret keys in an Android client application.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
